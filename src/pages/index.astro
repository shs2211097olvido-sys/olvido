---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./index/sections/_hero.astro";
import About from "./index/sections/_about.astro";
import Project from "./index/sections/_project.astro";
import Services from "./index/sections/_Services.astro";
import Contact from "./index/sections/_contact.astro";
---

<BaseLayout title="Nica Olvido Portfolio">
  <Hero slot="header" />

  <About />

  <main class="mx-auto grid max-w-4xl gap-5 md:grid-cols-3">
    <Project />
    <Services />
    <Contact />
  </main>
</BaseLayout>