<section id="contact" class="rounded-xl bg-gray-100 p-5 dark:bg-slate-400">
  <h2 class="mb-3 text-xl text-slate-900">Contact Me</h2>
  <form class="flex flex-col gap-3">
    <input class="rounded p-2 text-black" placeholder="Your Name" required />
    <input class="rounded p-2 text-black" type="email" placeholder="Your Email" required />
    <textarea class="rounded p-2 text-black" placeholder="Your Message" required></textarea>
    <button class="rounded bg-blue-500 p-2 text-white" type="button">
      Send Message
    </button>
  </form>
</section>